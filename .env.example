# Copia in .env.local e sostituisci con i tuoi valori.

# Neon Postgres, region UE (es. aws-eu-central-1)
DATABASE_URL=postgresql://utente:password@host.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Claude API
ANTHROPIC_API_KEY=sk-ant-valore-finto

# Facoltative: con DEMO_PASSWORD impostata l'app chiede l'accesso (il link di spedizione resta pubblico)
DEMO_USER=demo
DEMO_PASSWORD=cambia-questa-password
